# Copia este archivo como .env y rellena tus valores reales
# cp .env.example .env  (Linux/Mac)
# Copy-Item .env.example .env  (Windows PowerShell)

# Configuracion del servidor
PORT=3000

# Configuracion de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mejoravit_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Clave para consultar la lista de leads (GET /api/leads).
# Usa una cadena larga y aleatoria. Si la dejas vacia, la ruta queda desactivada.
# Generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Aviso por correo de cada lead nuevo (opcional).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contrasena de aplicacion"
# (https://myaccount.google.com/apppasswords), no tu contrasena normal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# Si publicas el sitio detras de un proxy (Render, Railway, nginx...), pon 1
TRUST_PROXY=
